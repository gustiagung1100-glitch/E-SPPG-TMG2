rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny global net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // SPPG Settings: Any signed-in user can read; only authenticated staff can update
    match /sppg_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId);
    }

    // Users collection: user can read/write their own profile; admins can list
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(userId);
    }

    // Institutions / Beneficiaries
    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(instId);
    }

    // Menu Items
    match /menu_items/{menuId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(menuId);
    }

    // Inventory & Stock
    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(itemId);
    }

    // Purchase Orders
    match /purchase_orders/{poId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(poId);
    }

    // Distribution Logs
    match /distribution_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(logId);
    }

    // Financial Transactions & Cash Flow
    match /financial_transactions/{txId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(txId);
    }

    // Volunteer Attendance & Tasks
    match /volunteer_attendance/{attId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(attId);
    }

    // Audit Logs: Append-only for logged activities
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }

    // Letters & Administrative Archive
    match /letters/{letterId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(letterId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
